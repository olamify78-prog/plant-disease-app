/python3.13/dist-packages/sklearn/metrics/_classification.py:1565: UndefinedMetricWarning: F-score is ill-defined and being set to 0.0 in labels with no true nor predicted samples. Use `zero_division` parameter to control this behavior.\n","  _warn_prf(average, modifier, f\"{metric.capitalize()} is\", len(result))\n"]},{"output_type":"display_data","data":{"text/plain":["<Figure size 1800x1600 with 2 Axes>"],"image/png":"\n"},"metadata":{}}]},{"cell_type":"code","source":["import tensorflow as tf\n","from tensorflow.keras import layers, models\n","import gc\n","\n","# Free up memory to keep our T4 GPU session stable\n","tf.keras.backend.clear_session()\n","gc.collect()\n","\n","print(\"🚀 Setting up our second comparison model: VGG16...\")\n","\n","# Load the pretrained VGG16 network as our alternative baseline\n","base_model_vgg = tf.keras.applications.VGG16(\n","    input_shape=(224, 224, 3),\n","    include_top=False,\n","    weights='imagenet'\n",")\n","\n","# Freeze the VGG16 layers to use it as a transfer learning comparison\n","base_model_vgg.trainable = False\n","\n","# Build the network using the same pipeline structure\n","model_vgg = models.Sequential([\n","    layers.Rescaling(1./255, input_shape=(224, 224, 3)),\n","    base_model_vgg,\n","    layers.GlobalAveragePooling2D(),\n","    layers.Dense(32, activation='relu'),\n","    layers.Dense(len(class_names), activation='softmax')\n","])\n","\n","# Compile the VGG16 model configuration\n","model_vgg.compile(\n","    optimizer='adam',\n","    loss='sparse_categorical_crossentropy',\n","    metrics=['accuracy']\n",")\n","\n","# Train the alternative model for a quick comparison\n","print(\"\\n🏋️ Training the VGG16 alternative model...\")\n","history_vgg = model_vgg.fit(\n","    train_ds,\n","    validation_data=val_ds,\n","    epochs=2\n",")\n","\n","# Evaluate the performance of our secondary approach\n","print(\"\\n📊 Running final evaluation for VGG16...\")\n","loss_vgg, accuracy_vgg = model_vgg.evaluate(val_ds)\n","print(f\"\\n✨ VGG16 Validation Loss: {loss_vgg:.4f}\")\n","print(f\"✨ VGG16 Validation Accuracy: {accuracy_vgg*100:.2f}%\")\n"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"9-w_g6KDU6zk","outputId":"a58b26ed-0602-4d5e-f715-efd3aa5ff114","executionInfo":{"status":"ok","timestamp":1791910652680,"user_tz":0,"elapsed":522556,"user":{"displayName":"Julius Olami","userId":"07206503722362485478"}}},"execution_count":20,"outputs":[{"output_type":"stream","name":"stdout","text":["🚀 Setting up our second comparison model: VGG16...\n","\n","🏋️ Training the VGG16 alternative model...\n","Epoch 1/2\n"]},{"output_type":"stream","name":"stderr","text":["/usr/local/lib/python3.13/dist-packages/keras/src/layers/preprocessing/data_layer.py:95: UserWarning: Do not pass an `input_shape`/`input_dim` argument to a layer. When using Sequential models, prefer using an `Input(shape)` object as the first layer in the model instead.\n","  super().__init__(**kwargs)\n"]},{"output_type":"stream","name":"stdout","text":["\u001b[1m2716/2716\u001b[0m \u001b[32m━━━━━━━━━━━━━━━━━━━━\u001b[0m\u001b[37m\u001b[0m \u001b[1m243s\u001b[0m 88ms/step - accuracy: 0.6016 - loss: 1.4966 - val_accuracy: 0.7915 - val_loss: 0.7838\n","Epoch 2/2\n","\u001b[1m2716/2716\u001b[0m \u001b[32m━━━━━━━━━━━━━━━━━━━━\u001b[0m\u001b[37m\u001b[0m \u001b[1m234s\u001b[0m 86ms/step - accuracy: 0.8162 - loss: 0.6258 - val_accuracy: 0.8301 - val_loss: 0.5942\n","\n","📊 Running final evaluation for VGG16...\n","\u001b[1m679/679\u001b[0m \u001b[32m━━━━━━━━━━━━━━━━━━━━\u001b[0m\u001b[37m\u001b[0m \u001b[1m47s\u001b[0m 69ms/step - accuracy: 0.8301 - loss: 0.5942\n","\n","✨ VGG16 Validation Loss: 0.5942\n","✨ VGG16 Validation Accuracy: 83.01%\n"]}]},{"cell_type":"code","source":["model.save(\"plant_disease_model.keras\")"],"metadata":{"id":"07RjG4XKhDoG","executionInfo":{"status":"ok","timestamp":1791910745521,"user_tz":0,"elapsed":471,"user":{"displayName":"Julius Olami","userId":"07206503722362485478"}}