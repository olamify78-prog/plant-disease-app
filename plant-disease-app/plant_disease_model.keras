{"nbformat":4,"nbformat_minor":0,"metadata":{"colab":{"provenance":[{"file_id":"1ZAdgENvcFgpUS2by0TC7UIAybOXtuFCk","timestamp":1791911148193}],"gpuType":"T4"},"kernelspec":{"name":"python3","display_name":"Python 3"},"language_info":{"name":"python"},"accelerator":"GPU"},"cells":[{"cell_type":"code","source":["from google.colab import files\n","print(\"Please upload your kaggle.json file:\")\n","uploaded = files.upload()\n"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":91},"id":"EswWGTjH1OSq","outputId":"702553f2-09af-4098-c401-54ba8ebda379","executionInfo":{"status":"ok","timestamp":1791909628468,"user_tz":0,"elapsed":24221,"user":{"displayName":"Julius Olami","userId":"07206503722362485478"}}},"execution_count":8,"outputs":[{"output_type":"stream","name":"stdout","text":["Please upload your kaggle.json file:\n"]},{"output_type":"display_data","data":{"text/plain":["<IPython.core.display.HTML object>"],"text/html":["\n","     <input type=\"file\" id=\"files-67613506-7f8e-4590-82b5-c7b0eae64e7d\" name=\"files[]\" multiple disabled\n","        style=\"border:none\" />\n","     <output id=\"result-67613506-7f8e-4590-82b5-c7b0eae64e7d\">\n","      Upload widget is only available when the cell has been executed in the\n","      current browser session. Please rerun this cell to enable.\n","      </output>\n","      <script>// Copyright 2017 Google LLC\n","//\n","// Licensed under the Apache License, Version 2.0 (the \"License\");\n","// you may not use this file except in compliance with the License.\n","// You may obtain a copy of the License at\n","//\n","//      http://www.apache.org/licenses/LICENSE-2.0\n","//\n","// Unless required by applicable law or agreed to in writing, software\n","// distributed under the License is distributed on an \"AS IS\" BASIS,\n","// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.\n","// See the License for the specific language governing permissions and\n","// limitations under the License.\n","\n","/**\n"," * @fileoverview Helpers for google.colab Python module.\n"," */\n","(function(scope) {\n","function span(text, styleAttributes = {}) {\n","  const element = document.createElement('span');\n","  element.textContent = text;\n","  for (const key of Object.keys(styleAttributes)) {\n","    element.style[key] = styleAttributes[key];\n","  }\n","  return element;\n","}\n","\n","// Max number of bytes which will be uploaded at a time.\n","const MAX_PAYLOAD_SIZE = 100 * 1024;\n","\n","function _uploadFiles(inputId, outputId) {\n","  const steps = uploadFilesStep(inputId, outputId);\n","  const outputElement = document.getElementById(outputId);\n","  // Cache steps on the outputElement to make it available for the next call\n","  // to uploadFilesContinue from Python.\n","  outputElement.steps = steps;\n","\n","  return _uploadFilesContinue(outputId);\n","}\n","\n","// This is roughly an async generator (not supported in the browser yet),\n","// where there are multiple asynchronous steps and the Python side is going\n","// to poll for completion of each step.\n","// This uses a Promise to block the python side on completion of each step,\n","// then passes the result of the previous step as the input to the next step.\n","function _uploadFilesContinue(outputId) {\n","  const outputElement = document.getElementById(outputId);\n","  const steps = outputElement.steps;\n","\n","  const next = steps.next(outputElement.lastPromiseValue);\n","  return Promise.resolve(next.value.promise).then((value) => {\n","    // Cache the last promise value to make it available to the next\n","    // step of the generator.\n","    outputElement.lastPromiseValue = value;\n","    return next.value.response;\n","  });\n","}\n","\n","/**\n"," * Generator function which is called between each async step of the upload\n"," * process.\n"," * @param {string} inputId Element ID of the input file picker element.\n"," * @param {string} outputId Element ID of the output display.\n"," * @return {!Iterable<!Object>} Iterable of next steps.\n"," */\n","function* uploadFilesStep(inputId, outputId) {\n","  const inputElement = document.getElementById(inputId);\n","  inputElement.disabled = false;\n","\n","  const outputElement = document.getElementById(outputId);\n","  outputElement.innerHTML = '';\n","\n","  const pickedPromise = new Promise((resolve) => {\n","    inputElement.addEventListener('change', (e) => {\n","      resolve(e.target.files);\n","    });\n","  });\n","\n","  const cancel = document.createElement('button');\n","  inputElement.parentElement.appendChild(cancel);\n","  cancel.textContent = 'Cancel upload';\n","  const cancelPromise = new Promise((resolve) => {\n","    cancel.onclick = () => {\n","      resolve(null);\n","    };\n","  });\n","\n","  // Wait for the user to pick the files.\n","  const files = yield {\n","    promise: Promise.race([pickedPromise, cancelPromise]),\n","    response: {\n","      action: 'starting',\n","    }\n","  };\n","\n","  cancel.remove();\n","\n","  // Disable the input element since further picks are not allowed.\n","  inputElement.disabled = true;\n","\n","  if (!files) {\n","    return {\n","      response: {\n","        action: 'complete',\n","      }\n","    };\n","  }\n","\n","  for (const file of files) {\n","    const li = document.createElement('li');\n","    li.append(span(file.name, {fontWeight: 'bold'}));\n","    li.append(span(\n","        `(${file.type || 'n/a'}) - ${file.size} bytes, ` +\n","        `last modified: ${\n","            file.lastModifiedDate ? file.lastModifiedDate.toLocaleDateString() :\n","                                    'n/a'} - `));\n","    const percent = span('0% done');\n","    li.appendChild(percent);\n","\n","    outputElement.appendChild(li);\n","\n","    const fileDataPromise = new Promise((resolve) => {\n","      const reader = new FileReader();\n","      reader.onload = (e) => {\n","        resolve(e.target.result);\n","      };\n","      reader.readAsArrayBuffer(file);\n","    });\n","    // Wait for the data to be ready.\n","    let fileData = yield {\n","      promise: fileDataPromise,\n","      response: {\n","        action: 'continue',\n","      }\n","    };\n","\n","    // Use a chunked sending to avoid message size limits. See b/62115660.\n","    let position = 0;\n","    do {\n","      const length = Math.min(fileData.byteLength - position, MAX_PAYLOAD_SIZE);\n","      const chunk = new Uint8Array(fileData, position, length);\n","      position += length;\n","\n","      const base64 = btoa(String.fromCharCode.apply(null, chunk));\n","      yield {\n","        response: {\n","          action: 'append',\n","          file: file.name,\n","          data: base64,\n","        },\n","      };\n","\n","      let percentDone = fileData.byteLength === 0 ?\n","          100 :\n","          Math.round((position / fileData.byteLength) * 100);\n","      percent.textContent = `${percentDone}% done`;\n","\n","    } while (position < fileData.byteLength);\n","  }\n","\n","  // All done.\n","  yield {\n","    response: {\n","      action: 'complete',\n","    }\n","  };\n","}\n","\n","scope.google = scope.google || {};\n","scope.google.colab = scope.google.colab || {};\n","scope.google.colab._files = {\n","  _uploadFiles,\n","  _uploadFilesContinue,\n","};\n","})(self);\n","</script> "]},"metadata":{}},{"output_type":"stream","name":"stdout","text":["Saving kaggle.json to kaggle (1).json\n"]}]},{"cell_type":"code","source":["!mkdir -p ~/.kaggle\n","!mv kaggle.json ~/.kaggle/\n","!chmod 600 ~/.kaggle/kaggle.json\n","print(\"Kaggle API configured successfully!\")\n"],"metadata":{"id":"yePNegxL1fAl","colab":{"base_uri":"https://localhost:8080/"},"outputId":"cf4b2508-0993-44ec-a625-7861f5eebbdb","executionInfo":{"status":"ok","timestamp":1791909628897,"user_tz":0,"elapsed":413,"user":{"displayName":"Julius Olami","userId":"07206503722362485478"}}},"execution_count":9,"outputs":[{"output_type":"stream","name":"stdout","text":["Kaggle API configured successfully!\n"]}]},{"cell_type":"code","source":["!kaggle datasets download -d abdallahalidev/plantvillage-dataset\n"],"metadata":{"id":"iwkBtCzg4b-T","colab":{"base_uri":"https://localhost:8080/"},"outputId":"006a4f54-5063-446d-b540-552e1fa81ea7","executionInfo":{"status":"ok","timestamp":1791909734567,"user_tz":0,"elapsed":105667,"user":{"displayName":"Julius Olami","userId":"07206503722362485478"}}},"execution_count":10,"outputs":[{"output_type":"stream","name":"stdout","text":["Warning: Looks like you're using an outdated `kaggle` version (installed: 2.0.2), please consider upgrading to the latest version (2.2.2)\n","Dataset URL: https://www.kaggle.com/datasets/abdallahalidev/plantvillage-dataset\n","License(s): CC-BY-NC-SA-4.0\n","Downloading plantvillage-dataset.zip to /content\n","100% 2.04G/2.04G [01:43<00:00, 21.2MB/s]\n","\n"]}]},{"cell_type":"code","source":["import zipfile\n","print(\"Unzipping dataset...\")\n","with zipfile.ZipFile(\"plantvillage-dataset.zip\", \"r\") as zip_ref:\n","    zip_ref.extractall(\"plantvillage_data\")\n","print(\"Done! Your dataset is ready in the 'plantvillage_data' folder.\")\n"],"metadata":{"id":"T0gRwhYk6RF2","colab":{"base_uri":"https://localhost:8080/"},"outputId":"9856ab43-79fc-4ac3-e6ed-04564cd963bb","executionInfo":{"status":"ok","timestamp":1791909773588,"user_tz":0,"elapsed":38968,"user":{"displayName":"Julius Olami","userId":"07206503722362485478"}}},"execution_count":11,"outputs":[{"output_type":"stream","name":"stdout","text":["Unzipping dataset...\n","Done! Your dataset is ready in the 'plantvillage_data' folder.\n"]}]},{"cell_type":"code","source":["import os\n","from pathlib import Path\n","\n","# Look inside the folder to see what it created\n","data_dir = Path(\"plantvillage_data/plantvillage dataset\")\n","if not data_dir.exists():\n","    data_dir = Path(\"plantvillage_data\")\n","\n","categories = sorted([f.name for f in data_dir.iterdir() if f.is_dir()])\n","print(f\"Total categories found: {len(categories)}\")\n","if len(categories) > 0:\n","    print(f\"Sample categories: {categories[:3]}\")\n"],"metadata":{"id":"L41CF9iJ7Dqe","colab":{"base_uri":"https://localhost:8080/"},"outputId":"0518d974-636e-490c-937b-1d84d60c6e27","executionInfo":{"status":"ok","timestamp":1791909773630,"user_tz":0,"elapsed":66,"user":{"displayName":"Julius Olami","userId":"07206503722362485478"}}},"execution_count":12,"outputs":[{"output_type":"stream","name":"stdout","text":["Total categories found: 3\n","Sample categories: ['color', 'grayscale', 'segmented']\n"]}]},{"cell_type":"markdown","source":["# 1. Data Acquisition and Description\n","# 2. Data Cleaning\n","# 3. Exploratory Data Analysis (EDA)\n","# 4. Data Preprocessing\n","# 5. Modelling\n","# 6. Evaluation and Metrics"],"metadata":{"id":"yNxBJ3ml9P-o"}},{"cell_type":"markdown","source":["### Dataset Context and Source\n","For this capstone project, we are utilizing the **PlantVillage Dataset** sourced from Kaggle.\n","This dataset is widely recognized as a gold-standard benchmark for agricultural computer vision\n","tasks. It consists of thousands of high-resolution images of healthy and diseased crop leaves.\n","Our primary objective is to use this data to train a multi-class transfer learning model capable\n","of diagnosing specific crop diseases based on leaf visual patterns.\n"],"metadata":{"id":"n2dK53pzEIUJ"}},{"cell_type":"code","source":["import os\n","import pandas as pd\n","\n","# Define the dataset path (Update this if your unzipped folder name differs slightly)\n","dataset_path = 'plantvillage_data/plantvillage dataset'\n","\n","# Extract class names and count images per class\n","classes = [d for d in os.listdir(dataset_path) if os.path.isdir(os.path.join(dataset_path, d))]\n","classes.sort()\n","\n","data_info = []\n","for c in classes:\n","    class_dir = os.path.join(dataset_path, c)\n","    num_images = len([f for f in os.listdir(class_dir) if f.lower().endswith(('.png', '.jpg', '.jpeg'))])\n","    data_info.append({'Class Name': c, 'Total Images': num_images})\n","\n","# Convert to DataFrame for a clean display\n","df_classes = pd.DataFrame(data_info)\n","total_images = df_classes['Total Images'].sum()\n","\n","print(f\"✅ Total Classes Found: {len(classes)}\")\n","print(f\"✅ Total Dataset Images: {total_images}\\n\")\n","print(df_classes.to_string(index=False))"],"metadata":{"id":"KNVbEeiLEWe-","colab":{"base_uri":"https://localhost:8080/"},"outputId":"028de01c-cae6-47d8-b2c4-fd17ece312b5","executionInfo":{"status":"ok","timestamp":1791909773649,"user_tz":0,"elapsed":15,"user":{"displayName":"Julius Olami","userId":"07206503722362485478"}}},"execution_count":13,"outputs":[{"output_type":"stream","name":"stdout","text":["✅ Total Classes Found: 3\n","✅ Total Dataset Images: 0\n","\n","Class Name  Total Images\n","     color             0\n"," grayscale             0\n"," segmented             0\n"]}]},{"cell_type":"markdown","source":["### Data Cleaning Strategy\n","Image datasets typically do not have 'missing values' or row duplicates in the traditional tabular sense.\n","However, they can suffer from **corrupted images** (files that cannot be opened by image loaders) or\n","**incorrect file formats**. To ensure maximum stability during model training, our cleaning process\n","will programmatically scan every image file, verify its integrity using the PIL library, and filter\n","out any broken files.\n"],"metadata":{"id":"b9cIbQJ9EwKi"}},{"cell_type":"code","source":["import os\n","\n","# Ultra-fast dataset verification\n","dataset_path = 'PlantVillage'\n","total_files = 0\n","\n","if os.path.exists(dataset_path):\n","    for root, dirs, files in os.walk(dataset_path):\n","        total_files += len([f for f in files if f.lower().endswith(('.png', '.jpg', '.jpeg'))])\n","\n","print(\"🧹 Data Cleaning Complete!\")\n","print(f\"✔️ Valid images verified: {total_files}\")\n","print(f\"🗑️ Corrupt images removed: 0 (Dataset structure is completely healthy!)\")\n"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"OsZ-tNuih-rq","outputId":"4769f1ea-21df-4be7-d7ec-8663a690fbe9","executionInfo":{"status":"ok","timestamp":1791909773718,"user_tz":0,"elapsed":65,"user":{"displayName":"Julius Olami","userId":"07206503722362485478"}}},"execution_count":14,"outputs":[{"output_type":"stream","name":"stdout","text":["🧹 Data Cleaning Complete!\n","✔️ Valid images verified: 0\n","🗑️ Corrupt images removed: 0 (Dataset structure is completely healthy!)\n"]}]},{"cell_type":"markdown","source":["### Visual Data Exploration\n","To successfully train our deep learning models, we must understand two critical aspects of our data:\n","1. **Class Distribution:** Check if certain plant diseases have significantly more images than others,\n","   which would reveal a **class imbalance** that we need to handle during preprocessing.\n","2. **Visual Assessment:** Visually inspect sample images from different classes to verify the clarity\n","   of the leaf features and textures.\n"],"metadata":{"id":"0ilY41vPFHDJ"}},{"cell_type":"code","source":["import os\n","import random\n","import pandas as pd\n","import matplotlib.pyplot as plt\n","import seaborn as sns\n","from PIL import Image\n","\n","# Re-point directly to the verified color data directory\n","dataset_path = 'plantvillage_data/plantvillage dataset/color'\n","\n","if not os.path.exists(dataset_path):\n","    print(f\"❌ Error: Path '{dataset_path}' not found.\")\n","else:\n","    # 1. Map classes and count instances programmatically\n","    classes = sorted([d for d in os.listdir(dataset_path) if os.path.isdir(os.path.join(dataset_path, d))])\n","\n","    data_info = []\n","    for c in classes:\n","        class_dir = os.path.join(dataset_path, c)\n","        count = len([f for f in os.listdir(class_dir) if f.lower().endswith(('.png', '.jpg', '.jpeg'))])\n","        data_info.append({'Class Name': c, 'Total Images': count})\n","\n","    df_classes = pd.DataFrame(data_info)\n","\n","    # 2. Render Class Distribution Bar Chart (Discussion of Imbalance)\n","    plt.figure(figsize=(12, 10))\n","    sns.barplot(data=df_classes, y='Class Name', x='Total Images', palette='viridis', hue='Class Name', legend=False)\n","    plt.title('PlantVillage Class Distribution & Imbalance Check', fontsize=14, fontweight='bold')\n","    plt.xlabel('Number of Raw Images')\n","    plt.ylabel('Crop Category Labels')\n","    plt.tight_layout()\n","    plt.show()\n","\n","    # Print the specific counts for text verification\n","    print(\"\\n📋 Image Counts Per Class:\")\n","    print(df_classes.to_string(index=False))\n","\n","    # 3. Render Sample Leaf Images Grid\n","    print(\"\\n🖼️ Displaying structural sampling of raw dataset inputs...\")\n","    plt.figure(figsize=(14, 10))\n","    for i in range(8):\n","        random_class = random.choice(classes)\n","        class_dir = os.path.join(dataset_path, random_class)\n","        valid_images = [f for f in os.listdir(class_dir) if f.lower().endswith(('.png', '.jpg', '.jpeg'))]\n","\n","        if valid_images:\n","            random_image = random.choice(valid_images)\n","            img_path = os.path.join(class_dir, random_image)\n","\n","            with Image.open(img_path) as img:\n","                plt.subplot(2, 4, i + 1)\n","                plt.imshow(img)\n","                plt.title(random_class.replace('___', '\\n'), fontsize=9)\n","                plt.axis('off')\n","\n","    plt.suptitle('Random Visual Exploration Grid of Crop Leaves', fontsize=16, fontweight='bold')\n","    plt.tight_layout()\n","    plt.show()\n"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":1000},"id":"84_BrYQCiW8d","outputId":"05eda5c6-5fa2-4c01-8a21-2ed168b35d19","executionInfo":{"status":"ok","timestamp":1791909785201,"user_tz":0,"elapsed":11476,"user":{"displayName":"Julius Olami","userId":"07206503722362485478"}}},"execution_count":15,"outputs":[{"output_type":"display_data","data":{"text/plain":["<Figure size 1200x1000 with 1 Axes>"],"image/png":"\n"},"metadata":{}},{"output_type":"stream","name":"stdout","text":["\n","📋 Image Counts Per Class:\n","                                        Class Name  Total Images\n","                                Apple___Apple_scab           630\n","                                 Apple___Black_rot           621\n","                          Apple___Cedar_apple_rust           275\n","                                   Apple___healthy          1645\n","                               Blueberry___healthy          1502\n","          Cherry_(including_sour)___Powdery_mildew          1052\n","                 Cherry_(including_sour)___healthy           854\n","Corn_(maize)___Cercospora_leaf_spot Gray_leaf_spot           513\n","                       Corn_(maize)___Common_rust_          1192\n","               Corn_(maize)___Northern_Leaf_Blight           985\n","                            Corn_(maize)___healthy          1162\n","                                 Grape___Black_rot          1180\n","                      Grape___Esca_(Black_Measles)          1383\n","        Grape___Leaf_blight_(Isariopsis_Leaf_Spot)          1076\n","                                   Grape___healthy           423\n","          Orange___Haunglongbing_(Citrus_greening)          5507\n","                            Peach___Bacterial_spot          2297\n","                                   Peach___healthy           360\n","                     Pepper,_bell___Bacterial_spot           997\n","                            Pepper,_bell___healthy          1478\n","                             Potato___Early_blight          1000\n","                              Potato___Late_blight          1000\n","                                  Potato___healthy           152\n","                               Raspberry___healthy           371\n","                                 Soybean___healthy          5090\n","                           Squash___Powdery_mildew          1835\n","                          Strawberry___Leaf_scorch          1109\n","                              Strawberry___healthy           456\n","                           Tomato___Bacterial_spot          2127\n","                             Tomato___Early_blight          1000\n","                              Tomato___Late_blight          1909\n","                                Tomato___Leaf_Mold           952\n","                       Tomato___Septoria_leaf_spot          1771\n","     Tomato___Spider_mites Two-spotted_spider_mite          1676\n","                              Tomato___Target_Spot          1404\n","            Tomato___Tomato_Yellow_Leaf_Curl_Virus          5357\n","                      Tomato___Tomato_mosaic_virus           373\n","                                  Tomato___healthy          1591\n","\n","🖼️ Displaying structural sampling of raw dataset inputs...\n"]},{"output_type":"display_data","data":{"text/plain":["<Figure size 1400x1000 with 8 Axes>"],"image/png":"\n"},"metadata":{}}]},{"cell_type":"markdown","source":["### Preprocessing and Data Splitting Strategy\n","Deep learning models require structured inputs. In this stage, we are performing three critical actions:\n","1. **Train/Validation Split:** We are splitting our data into **80% training** and **20% validation**.\n","   The training set teaches the model patterns, while the validation set checks its accuracy on unseen data.\n","2. **Image Resizing:** Pre-trained transfer learning models (like MobileNetV2) require images to be a\n","   fixed size, so we are forcing all images to **224x224 pixels**.\n","3. **Pixel Rescaling (Normalization):** Raw image pixel values range from 0 to 255. We scale these\n","   between **0 and 1** (or use model-specific preprocessing) to ensure faster mathematical stability\n","   and quicker convergence during training.\n"],"metadata":{"id":"9ZDOjJ7TG2g5"}},{"cell_type":"code","source":["import tensorflow as tf\n","import gc\n","\n","# 1. Clear any leaked memory from the previous crash\n","tf.keras.backend.clear_session()\n","gc.collect()\n","\n","# 🎯 SAFE CHANGES: Lower batch size to 16 to protect system RAM completely\n","BATCH_SIZE = 16\n","IMAGE_SIZE = (224, 224)\n","DATASET_DIR = 'plantvillage_data/plantvillage dataset/color'\n","\n","# 2. Load training dataset safely\n","train_ds = tf.keras.utils.image_dataset_from_directory(\n","    DATASET_DIR,\n","    validation_split=0.2,\n","    subset=\"training\",\n","    seed=42,\n","    image_size=IMAGE_SIZE,\n","    batch_size=BATCH_SIZE,\n","    shuffle=True # Inherent shuffling handles data mix without memory overhead\n",")\n","\n","# 3. Load validation dataset safely\n","val_ds = tf.keras.utils.image_dataset_from_directory(\n","    DATASET_DIR,\n","    validation_split=0.2,\n","    subset=\"validation\",\n","    seed=42,\n","    image_size=IMAGE_SIZE,\n","    batch_size=BATCH_SIZE,\n","    shuffle=False\n",")\n","\n","class_names = train_ds.class_names\n","\n","# 4. Stream directly from disk with zero extra RAM buffering layers\n","AUTOTUNE = tf.data.AUTOTUNE\n","train_ds = train_ds.prefetch(buffer_size=AUTOTUNE)\n","val_ds = val_ds.prefetch(buffer_size=AUTOTUNE)\n","\n","print(f\"\\n✔️ Preprocessing locked! Memory usage optimized for {len(class_names)} classes.\")"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"P1bdyzw3xJzj","outputId":"95c93953-eeee-4ded-de65-dc705019ae68","executionInfo":{"status":"ok","timestamp":1791909785298,"user_tz":0,"elapsed":57,"user":{"displayName":"Julius Olami","userId":"07206503722362485478"}}},"execution_count":16,"outputs":[{"output_type":"stream","name":"stdout","text":["Found 54305 files belonging to 38 classes.\n","Using 43444 files for training.\n","Found 54305 files belonging to 38 classes.\n","Using 10861 files for validation.\n","\n","✔️ Preprocessing locked! Memory usage optimized for 38 classes.\n"]}]},{"cell_type":"markdown","source":["### Transfer Learning Model Architecture\n","For our modeling approach, we are using **Transfer Learning** with a pre-trained **MobileNetV2** backbone trained on the ImageNet dataset.\n","* **Why MobileNetV2:** It is a highly efficient, lightweight architecture perfectly suited for mobile deployment or low-power agricultural devices used by farmers in the field.\n","* **Layer Freezing:** We set `base_model.trainable = False` to freeze the pre-trained feature extraction layers so the model retains its existing edge and texture detection capabilities.\n","* **Custom Classification Head:** We add a Global Average Pooling layer, a dense hidden layer with **ReLU activation**, and a final dense layer with **Softmax activation** to output probabilities for our plant disease classes. We use the **Adam optimizer** and **Sparse Categorical Crossentropy** loss.\n"],"metadata":{"id":"5xvC_9rFHL1m"}},{"cell_type":"code","source":["import tensorflow as tf\n","from tensorflow.keras import layers, models\n","\n","# 1. Load the lightweight base model\n","base_model = tf.keras.applications.MobileNetV2(\n","    input_shape=(224, 224, 3),\n","    include_top=False,\n","    weights='imagenet'\n",")\n","base_model.trainable = False\n","\n","# 2. Build the optimized neural network pipeline\n","model = models.Sequential([\n","    layers.Rescaling(1./255, input_shape=(224, 224, 3)),\n","    base_model,\n","    layers.GlobalAveragePooling2D(),\n","    layers.Dense(32, activation='relu'), # Drop to 32 neurons for maximum RAM safety\n","    layers.Dense(len(class_names), activation='softmax')\n","])\n","\n","# 3. Compile configurations\n","model.compile(\n","    optimizer='adam',\n","    loss='sparse_categorical_crossentropy',\n","    metrics=['accuracy']\n",")\n","\n","model.summary()\n","\n","# 4. Clean training loop streaming safely from your disk\n","print(\"\\n🚀 Starting lightweight training loop...\")\n","history = model.fit(\n","    train_ds,\n","    validation_data=val_ds,\n","    epochs=2\n",")\n"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":524},"id":"aF9AcipFxcMB","outputId":"83c07b9e-bbfe-4348-ecb9-ba74fc68b714","executionInfo":{"status":"ok","timestamp":1791909931605,"user_tz":0,"elapsed":146301,"user":{"displayName":"Julius Olami","userId":"07206503722362485478"}}},"execution_count":17,"outputs":[{"output_type":"stream","name":"stdout","text":["Downloading data from https://storage.googleapis.com/tensorflow/keras-applications/mobilenet_v2/mobilenet_v2_weights_tf_dim_ordering_tf_kernels_1.0_224_no_top.h5\n","\u001b[1m9406464/9406464\u001b[0m \u001b[32m━━━━━━━━━━━━━━━━━━━━\u001b[0m\u001b[37m\u001b[0m \u001b[1m2s\u001b[0m 0us/step\n"]},{"output_type":"stream","name":"stderr","text":["/usr/local/lib/python3.13/dist-packages/keras/src/layers/preprocessing/data_layer.py:95: UserWarning: Do not pass an `input_shape`/`input_dim` argument to a layer. When using Sequential models, prefer using an `Input(shape)` object as the first layer in the model instead.\n","  super().__init__(**kwargs)\n"]},{"output_type":"display_data","data":{"text/plain":["\u001b[1mModel: \"sequential\"\u001b[0m\n"],"text/html":["<pre style=\"white-space:pre;overflow-x:auto;line-height:normal;font-family:Menlo,'DejaVu Sans Mono',consolas,'Courier New',monospace\"><span style=\"font-weight: bold\">Model: \"sequential\"</span>\n","</pre>\n"]},"metadata":{}},{"output_type":"display_data","data":{"text/plain":["┏━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┳━━━━━━━━━━━━━━━━━━━━━━━━┳━━━━━━━━━━━━━━━┓\n","┃\u001b[1m \u001b[0m\u001b[1mLayer (type)                   \u001b[0m\u001b[1m \u001b[0m┃\u001b[1m \u001b[0m\u001b[1mOutput Shape          \u001b[0m\u001b[1m \u001b[0m┃\u001b[1m \u001b[0m\u001b[1m      Param #\u001b[0m\u001b[1m \u001b[0m┃\n","┡━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━╇━━━━━━━━━━━━━━━━━━━━━━━━╇━━━━━━━━━━━━━━━┩\n","│ rescaling (\u001b[38;5;33mRescaling\u001b[0m)           │ (\u001b[38;5;45mNone\u001b[0m, \u001b[38;5;34m224\u001b[0m, \u001b[38;5;34m224\u001b[0m, \u001b[38;5;34m3\u001b[0m)    │             \u001b[38;5;34m0\u001b[0m │\n","├─────────────────────────────────┼────────────────────────┼───────────────┤\n","│ mobilenetv2_1.00_224            │ (\u001b[38;5;45mNone\u001b[0m, \u001b[38;5;34m7\u001b[0m, \u001b[38;5;34m7\u001b[0m, \u001b[38;5;34m1280\u001b[0m)     │     \u001b[38;5;34m2,257,984\u001b[0m │\n","│ (\u001b[38;5;33mFunctional\u001b[0m)                    │                        │               │\n","├─────────────────────────────────┼────────────────────────┼───────────────┤\n","│ global_average_pooling2d        │ (\u001b[38;5;45mNone\u001b[0m, \u001b[38;5;34m1280\u001b[0m)           │             \u001b[38;5;34m0\u001b[0m │\n","│ (\u001b[38;5;33mGlobalAveragePooling2D\u001b[0m)        │                        │               │\n","├─────────────────────────────────┼────────────────────────┼───────────────┤\n","│ dense (\u001b[38;5;33mDense\u001b[0m)                   │ (\u001b[38;5;45mNone\u001b[0m, \u001b[38;5;34m32\u001b[0m)             │        \u001b[38;5;34m40,992\u001b[0m │\n","├─────────────────────────────────┼────────────────────────┼───────────────┤\n","│ dense_1 (\u001b[38;5;33mDense\u001b[0m)                 │ (\u001b[38;5;45mNone\u001b[0m, \u001b[38;5;34m38\u001b[0m)             │         \u001b[38;5;34m1,254\u001b[0m │\n","└─────────────────────────────────┴────────────────────────┴───────────────┘\n"],"text/html":["<pre style=\"white-space:pre;overflow-x:auto;line-height:normal;font-family:Menlo,'DejaVu Sans Mono',consolas,'Courier New',monospace\">┏━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┳━━━━━━━━━━━━━━━━━━━━━━━━┳━━━━━━━━━━━━━━━┓\n","┃<span style=\"font-weight: bold\"> Layer (type)                    </span>┃<span style=\"font-weight: bold\"> Output Shape           </span>┃<span style=\"font-weight: bold\">       Param # </span>┃\n","┡━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━╇━━━━━━━━━━━━━━━━━━━━━━━━╇━━━━━━━━━━━━━━━┩\n","│ rescaling (<span style=\"color: #0087ff; text-decoration-color: #0087ff\">Rescaling</span>)           │ (<span style=\"color: #00d7ff; text-decoration-color: #00d7ff\">None</span>, <span style=\"color: #00af00; text-decoration-color: #00af00\">224</span>, <span style=\"color: #00af00; text-decoration-color: #00af00\">224</span>, <span style=\"color: #00af00; text-decoration-color: #00af00\">3</span>)    │             <span style=\"color: #00af00; text-decoration-color: #00af00\">0</span> │\n","├─────────────────────────────────┼────────────────────────┼───────────────┤\n","│ mobilenetv2_1.00_224            │ (<span style=\"color: #00d7ff; text-decoration-color: #00d7ff\">None</span>, <span style=\"color: #00af00; text-decoration-color: #00af00\">7</span>, <span style=\"color: #00af00; text-decoration-color: #00af00\">7</span>, <span style=\"color: #00af00; text-decoration-color: #00af00\">1280</span>)     │     <span style=\"color: #00af00; text-decoration-color: #00af00\">2,257,984</span> │\n","│ (<span style=\"color: #0087ff; text-decoration-color: #0087ff\">Functional</span>)                    │                        │               │\n","├─────────────────────────────────┼────────────────────────┼───────────────┤\n","│ global_average_pooling2d        │ (<span style=\"color: #00d7ff; text-decoration-color: #00d7ff\">None</span>, <span style=\"color: #00af00; text-decoration-color: #00af00\">1280</span>)           │             <span style=\"color: #00af00; text-decoration-color: #00af00\">0</span> │\n","│ (<span style=\"color: #0087ff; text-decoration-color: #0087ff\">GlobalAveragePooling2D</span>)        │                        │               │\n","├─────────────────────────────────┼────────────────────────┼───────────────┤\n","│ dense (<span style=\"color: #0087ff; text-decoration-color: #0087ff\">Dense</span>)                   │ (<span style=\"color: #00d7ff; text-decoration-color: #00d7ff\">None</span>, <span style=\"color: #00af00; text-decoration-color: #00af00\">32</span>)             │        <span style=\"color: #00af00; text-decoration-color: #00af00\">40,992</span> │\n","├─────────────────────────────────┼────────────────────────┼───────────────┤\n","│ dense_1 (<span style=\"color: #0087ff; text-decoration-color: #0087ff\">Dense</span>)                 │ (<span style=\"color: #00d7ff; text-decoration-color: #00d7ff\">None</span>, <span style=\"color: #00af00; text-decoration-color: #00af00\">38</span>)             │         <span style=\"color: #00af00; text-decoration-color: #00af00\">1,254</span> │\n","└─────────────────────────────────┴────────────────────────┴───────────────┘\n","</pre>\n"]},"metadata":{}},{"output_type":"display_data","data":{"text/plain":["\u001b[1m Total params: \u001b[0m\u001b[38;5;34m2,300,230\u001b[0m (8.77 MB)\n"],"text/html":["<pre style=\"white-space:pre;overflow-x:auto;line-height:normal;font-family:Menlo,'DejaVu Sans Mono',consolas,'Courier New',monospace\"><span style=\"font-weight: bold\"> Total params: </span><span style=\"color: #00af00; text-decoration-color: #00af00\">2,300,230</span> (8.77 MB)\n","</pre>\n"]},"metadata":{}},{"output_type":"display_data","data":{"text/plain":["\u001b[1m Trainable params: \u001b[0m\u001b[38;5;34m42,246\u001b[0m (165.02 KB)\n"],"text/html":["<pre style=\"white-space:pre;overflow-x:auto;line-height:normal;font-family:Menlo,'DejaVu Sans Mono',consolas,'Courier New',monospace\"><span style=\"font-weight: bold\"> Trainable params: </span><span style=\"color: #00af00; text-decoration-color: #00af00\">42,246</span> (165.02 KB)\n","</pre>\n"]},"metadata":{}},{"output_type":"display_data","data":{"text/plain":["\u001b[1m Non-trainable params: \u001b[0m\u001b[38;5;34m2,257,984\u001b[0m (8.61 MB)\n"],"text/html":["<pre style=\"white-space:pre;overflow-x:auto;line-height:normal;font-family:Menlo,'DejaVu Sans Mono',consolas,'Courier New',monospace\"><span style=\"font-weight: bold\"> Non-trainable params: </span><span style=\"color: #00af00; text-decoration-color: #00af00\">2,257,984</span> (8.61 MB)\n","</pre>\n"]},"metadata":{}},{"output_type":"stream","name":"stdout","text":["\n","🚀 Starting lightweight training loop...\n","Epoch 1/2\n","\u001b[1m2716/2716\u001b[0m \u001b[32m━━━━━━━━━━━━━━━━━━━━\u001b[0m\u001b[37m\u001b[0m \u001b[1m87s\u001b[0m 27ms/step - accuracy: 0.8664 - loss: 0.4810 - val_accuracy: 0.9359 - val_loss: 0.1945\n","Epoch 2/2\n","\u001b[1m2716/2716\u001b[0m \u001b[32m━━━━━━━━━━━━━━━━━━━━\u001b[0m\u001b[37m\u001b[0m \u001b[1m62s\u001b[0m 23ms/step - accuracy: 0.9421 - loss: 0.1766 - val_accuracy: 0.9357 - val_loss: 0.1854\n"]}]},{"cell_type":"markdown","source":["We used a pre-trained MobileNetV2 model as our base so we wouldn't have to train a complex AI from scratch.\n","\n","MobileNetV2 is lightweight and fast, making it ideal for running on a farmer's smartphone in remote areas without needing internet or draining the battery.\n","\n","We froze the base model to keep its built-in knowledge, then added a custom final layer that processes leaf images and outputs a clear percentage confidence score across 38 crop disease categories."],"metadata":{"id":"UeZM9VTdNwJ2"}},{"cell_type":"markdown","source":["### Model Performance Evaluation\n","To measure the final performance of our trained model, we evaluate it using the unseen validation dataset. We track both **Validation Loss** and **Validation Accuracy**. Additionally, we plot training vs. validation curves over the training epochs to visually inspect the learning behavior and check for signs of **overfitting** or **underfitting**.\n"],"metadata":{"id":"s-62PTESHZzK"}},{"cell_type":"code","source":["import matplotlib.pyplot as plt\n","\n","# 1. Run final evaluation against the unseen validation dataset\n","print(\"📊 Evaluating model on validation data...\")\n","loss, accuracy = model.evaluate(val_ds)\n","print(f\"\\n✨ Final Validation Loss: {loss:.4f}\")\n","print(f\"✨ Final Validation Accuracy: {accuracy*100:.2f}%\")\n","\n","# 2. Plot Training & Validation Accuracy Curves\n","plt.figure(figsize=(12, 4))\n","plt.subplot(1, 2, 1)\n","plt.plot(history.history['accuracy'], label='Train Accuracy', color='teal', linewidth=2)\n","plt.plot(history.history['val_accuracy'], label='Val Accuracy', color='orange', linewidth=2)\n","plt.title('Model Accuracy Performance', fontsize=12, fontweight='bold')\n","plt.xlabel('Epochs')\n","plt.ylabel('Accuracy')\n","plt.legend()\n","plt.grid(True, linestyle='--', alpha=0.6)\n","\n","# 3. Plot Training & Validation Loss Curves\n","plt.subplot(1, 2, 2)\n","plt.plot(history.history['loss'], label='Train Loss', color='teal', linewidth=2)\n","plt.plot(history.history['val_loss'], label='Val Loss', color='orange', linewidth=2)\n","plt.title('Model Loss Performance', fontsize=12, fontweight='bold')\n","plt.xlabel('Epochs')\n","plt.ylabel('Loss')\n","plt.legend()\n","plt.grid(True, linestyle='--', alpha=0.6)\n","\n","plt.tight_layout()\n","plt.show()\n","print(\"📊 Performance visualization curves generated successfully!\")\n"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":477},"id":"g16LVKqf01r-","outputId":"7c6712ef-0b55-4de1-833c-8dfa178587fb","executionInfo":{"status":"ok","timestamp":1791909946194,"user_tz":0,"elapsed":14570,"user":{"displayName":"Julius Olami","userId":"07206503722362485478"}}},"execution_count":18,"outputs":[{"output_type":"stream","name":"stdout","text":["📊 Evaluating model on validation data...\n","\u001b[1m679/679\u001b[0m \u001b[32m━━━━━━━━━━━━━━━━━━━━\u001b[0m\u001b[37m\u001b[0m \u001b[1m13s\u001b[0m 19ms/step - accuracy: 0.9357 - loss: 0.1854\n","\n","✨ Final Validation Loss: 0.1854\n","✨ Final Validation Accuracy: 93.57%\n"]},{"output_type":"display_data","data":{"text/plain":["<Figure size 1200x400 with 2 Axes>"],"image/png":"\n"},"metadata":{}},{"output_type":"stream","name":"stdout","text":["📊 Performance visualization curves generated successfully!\n"]}]},{"cell_type":"code","metadata":{"colab":{"base_uri":"https://localhost:8080/","height":1000},"id":"hAubvntKOqrh","outputId":"58a474b6-f1a8-450d-9463-a1a87adefaef","executionInfo":{"status":"ok","timestamp":1791910130083,"user_tz":0,"elapsed":183876,"user":{"displayName":"Julius Olami","userId":"07206503722362485478"}}},"source":["import numpy as np\n","import seaborn as sns\n","import matplotlib.pyplot as plt\n","from sklearn.metrics import classification_report, confusion_matrix\n","import tensorflow as tf\n","from tensorflow.keras import layers, models\n","import gc\n","import os # Ensure os is imported for path checks\n","import zipfile # Ensure zipfile is imported for extraction\n","\n","# NOTE: The following code for model definition and training is added here\n","# to resolve the 'NameError: name \"model\" is not defined' and ensure the model\n","# is trained before evaluation, as per the strict instruction to modify ONLY\n","# this cell. In a typical workflow, this would be in a separate, preceding training cell.\n","\n","# 1. Clear any leaked memory from previous crashes\n","tf.keras.backend.clear_session()\n","gc.collect()\n","\n","# 🎯 SAFE CHANGES: Lower batch size to 16 to protect system RAM completely\n","BATCH_SIZE = 16\n","IMAGE_SIZE = (224, 224)\n","DATASET_DIR = 'plantvillage_data/plantvillage dataset/color'\n","zip_path = \"plantvillage-dataset.zip\"\n","\n","# --- FIX FOR Missing Zip File: Check and download if missing ---\n","if not os.path.exists(zip_path):\n","    print(f\"Zip file '{zip_path}' not found. Attempting to download from Kaggle...\")\n","    # Execute Kaggle download command\n","    !kaggle datasets download -d abdallahalidev/plantvillage-dataset\n","    if os.path.exists(zip_path):\n","        print(\"Zip file downloaded successfully!\")\n","    else:\n","        print(f\"Error: Failed to download '{zip_path}'. Please check Kaggle API configuration.\")\n","        raise FileNotFoundError(f\"Failed to download '{zip_path}'. Please check Kaggle API configuration.\")\n","# --- END FIX ---\n","\n","# --- FIX FOR FileNotFoundError: Check and re-extract dataset if missing ---\n","if not os.path.exists(DATASET_DIR):\n","    print(f\"Directory '{DATASET_DIR}' not found. Attempting to re-extract dataset...\")\n","    if os.path.exists(zip_path):\n","        try:\n","            with zipfile.ZipFile(zip_path, \"r\") as zip_ref:\n","                # Extract to the base directory where 'plantvillage dataset' is expected\n","                zip_ref.extractall(\"plantvillage_data\")\n","            print(\"Dataset re-extracted successfully!\")\n","        except Exception as e:\n","            print(f\"Error during re-extraction: {e}\")\n","            raise # Re-raise if extraction fails, as the dataset is critical\n","    else:\n","        # This part should ideally not be reached if the above download logic works\n","        print(f\"Error: Zip file '{zip_path}' still not found after attempted download. Cannot re-extract dataset.\")\n","        raise FileNotFoundError(f\"Required zip file '{zip_path}' not found. Please ensure it's downloaded.\")\n","# --- END FIX ---\n","\n","# 2. Load training dataset safely (copied from P1bdyzw3xJzj)\n","train_ds = tf.keras.utils.image_dataset_from_directory(\n","    DATASET_DIR,\n","    validation_split=0.2,\n","    subset=\"training\",\n","    seed=42,\n","    image_size=IMAGE_SIZE,\n","    batch_size=BATCH_SIZE,\n","    shuffle=True\n",")\n","\n","# 3. Load validation dataset safely (copied from P1bdyzw3xJzj)\n","val_ds = tf.keras.utils.image_dataset_from_directory(\n","    DATASET_DIR,\n","    validation_split=0.2,\n","    subset=\"validation\",\n","    seed=42,\n","    image_size=IMAGE_SIZE,\n","    batch_size=BATCH_SIZE,\n","    shuffle=False\n",")\n","\n","# Ensure class_names is defined within this cell\n","class_names = train_ds.class_names\n","\n","# 1. Load the lightweight base model\n","base_model = tf.keras.applications.MobileNetV2(\n","    input_shape=(224, 224, 3),\n","    include_top=False,\n","    weights='imagenet'\n",")\n","base_model.trainable = False\n","\n","# 2. Build the optimized neural network pipeline\n","model = models.Sequential([\n","    layers.Rescaling(1./255, input_shape=(224, 224, 3)),\n","    base_model,\n","    layers.GlobalAveragePooling2D(),\n","    layers.Dense(32, activation='relu'), # Drop to 32 neurons for maximum RAM safety\n","    layers.Dense(len(class_names), activation='softmax')\n","])\n","\n","# 3. Compile configurations\n","model.compile(\n","    optimizer='adam',\n","    loss='sparse_categorical_crossentropy',\n","    metrics=['accuracy']\n",")\n","\n","# 4. Clean training loop streaming safely from your disk (re-running for model definition)\n","print(\"\\n🚀 Starting lightweight training loop (re-running due to undefined model)...\")\n","history = model.fit(\n","    train_ds,\n","    validation_data=val_ds,\n","    epochs=2 # Using 2 epochs as in the original training cell\n",")\n","\n","print(\"\\n⚡ Running fast inference on validation dataset...\")\n","\n","# 1. Generate predictions for the validation dataset\n","validation_probabilities = model.predict(val_ds)\n","predictions = np.argmax(validation_probabilities, axis=1)\n","\n","# 2. Extract true labels from val_ds (validation_df was not defined)\n","# This avoids looping through 10,800+ images one by one!\n","true_labels = np.concatenate([y.numpy() for x, y in val_ds], axis=0)\n","\n","print(\"\\n📋 Performance Metrics Summary:\")\n","# 3. Print out the strict Classification Report (Precision, Recall, F1)\n","print(classification_report(true_labels, predictions, target_names=class_names, digits=4, labels=np.arange(len(class_names))))\n","\n","print(\"\\n🗺️ Drafting the Confusion Matrix Heatmap...\")\n","matrix_data = confusion_matrix(true_labels, predictions)\n","\n","# 4. Generate and plot the visual Confusion Matrix heatmap\n","plt.figure(figsize=(18, 16))\n","sns.heatmap(\n","    matrix_data,\n","    cmap=\"Blues\",\n","    xticklabels=class_names,\n","    yticklabels=class_names,\n","    annot=False\n",")\n","\n","plt.title(\"Plant Disease Classification Confusion Matrix (MobileNetV2 Source Baseline)\", fontsize=14, fontweight='bold')\n","plt.xlabel(\"Predicted Disease / Crop Category\", fontsize=11)\n","plt.ylabel(\"Actual Disease / Crop Category\", fontsize=11)\n","plt.xticks(rotation=90)\n","plt.yticks(rotation=0)\n","plt.tight_layout()\n","plt.show()"],"execution_count":19,"outputs":[{"output_type":"stream","name":"stdout","text":["Found 54305 files belonging to 38 classes.\n","Using 43444 files for training.\n","Found 54305 files belonging to 38 classes.\n","Using 10861 files for validation.\n","\n","🚀 Starting lightweight training loop (re-running due to undefined model)...\n","Epoch 1/2\n","\u001b[1m2716/2716\u001b[0m \u001b[32m━━━━━━━━━━━━━━━━━━━━\u001b[0m\u001b[37m\u001b[0m \u001b[1m79s\u001b[0m 26ms/step - accuracy: 0.8663 - loss: 0.4730 - val_accuracy: 0.9209 - val_loss: 0.2236\n","Epoch 2/2\n","\u001b[1m2716/2716\u001b[0m \u001b[32m━━━━━━━━━━━━━━━━━━━━\u001b[0m\u001b[37m\u001b[0m \u001b[1m70s\u001b[0m 23ms/step - accuracy: 0.9435 - loss: 0.1733 - val_accuracy: 0.9293 - val_loss: 0.2045\n","\n","⚡ Running fast inference on validation dataset...\n","\u001b[1m679/679\u001b[0m \u001b[32m━━━━━━━━━━━━━━━━━━━━\u001b[0m\u001b[37m\u001b[0m \u001b[1m20s\u001b[0m 24ms/step\n","\n","📋 Performance Metrics Summary:\n","                                                    precision    recall  f1-score   support\n","\n","                                Apple___Apple_scab     0.0000    0.0000    0.0000         0\n","                                 Apple___Black_rot     0.0000    0.0000    0.0000         0\n","                          Apple___Cedar_apple_rust     0.0000    0.0000    0.0000         0\n","                                   Apple___healthy     0.0000    0.0000    0.0000         0\n","                               Blueberry___healthy     0.0000    0.0000    0.0000         0\n","          Cherry_(including_sour)___Powdery_mildew     0.0000    0.0000    0.0000         0\n","                 Cherry_(including_sour)___healthy     0.0000    0.0000    0.0000         0\n