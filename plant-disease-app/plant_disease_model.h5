"code","source":["model.save('plant_disease_model.h5')"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"07RjG4XKhDoG","executionInfo":{"status":"ok","timestamp":1791882695092,"user_tz":0,"elapsed":512,"user":{"displayName":"Julius Olami","userId":"07206503722362485478"}},"outputId":"01dc7914-3bc3-453f-8792-2399f1646d28"},"execution_count":21,"outputs":[{"output_type":"stream","name":"stderr","text":["WARNING:absl:You are saving your model as an HDF5 file via `model.save()` or `keras.saving.save_model(model)`. This file format is considered legacy. We recommend using instead the native Keras format, e.g. `model.save('my_model.keras')` or `keras.saving.save_model(model, 'my_model.keras')`. \n"]}]}]}